# Headers every proxied location needs.
#
# X-Forwarded-Proto is what makes Django's SECURE_PROXY_SSL_HEADER work: it is
# set here (overwriting anything the client sent) so a client cannot claim its
# plain-HTTP request arrived over TLS.

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;

proxy_http_version 1.1;
proxy_set_header Connection "";

proxy_connect_timeout 10s;
proxy_send_timeout    120s;
proxy_read_timeout    120s;

proxy_buffering on;
proxy_buffer_size 8k;
proxy_buffers 16 8k;
