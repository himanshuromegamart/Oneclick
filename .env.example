# ---------------------------------------------------------------------------
# Environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored - never commit real values.
# On the production server, set these as real environment variables instead.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_FORMATTER=plain

# --- Database -------------------------------------------------------------
POSTGRES_DB=sarah_aqua_erp
POSTGRES_USER=sarah
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# require | verify-full | disable  (production must not use `disable`)
POSTGRES_SSLMODE=disable

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- JWT ------------------------------------------------------------------
# Separate from DJANGO_SECRET_KEY so tokens can be rotated independently.
JWT_SIGNING_KEY=
# 1440 = 24 hours. Anything shorter logs the mobile app out mid-day unless
# the app refreshes its token, so keep this and the default in base.py the
# same - a stale value here silently overrides the code.
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=30

# --- Browser sessions -----------------------------------------------------
# How long the dashboard stays signed in while idle. 43200 = 12 hours. The
# clock resets on every request, so this is inactivity, not total time.
SESSION_COOKIE_AGE=43200

# --- SMS gateway (NimbusIT) ----------------------------------------------
# ConsoleSMSBackend prints the OTP to the terminal - use it while developing.
# NimbusITSMSBackend sends a real SMS and spends credits.
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
SMS_BASE_URL=https://nimbusit.biz/api/SmsApi/SendSingleApi
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
# DLT registration - mandatory for transactional SMS in India.
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=
# Must match the approved DLT template word for word.
SMS_OTP_TEMPLATE={otp} is your OTP for login. Do not share it with anyone.

# --- OTP policy -----------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_DAY=10
OTP_LOCKOUT_SECONDS=1800

# --- Cloudinary (file storage) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sarah-aqua-soft
CLOUDINARY_SIGNED_URL_TTL=900

# --- Limits ---------------------------------------------------------------
# 10 MB, because that is what Cloudinary's free plan actually accepts:
#   "File size too large. Got 11534345. Maximum is 10485760."
# Setting this higher does not store bigger files - it only means the upload
# travels the whole way to Cloudinary before being refused. Raise it when the
# Cloudinary plan is raised, and not before.
MAX_UPLOAD_BYTES=10485760
RECYCLE_BIN_RETENTION_DAYS=30
SHARE_LINK_TTL_HOURS=168
FOLDER_MAX_DEPTH=32

# --- Production only ------------------------------------------------------
SENTRY_DSN=
SECURE_SSL_REDIRECT=true
APP_VERSION=1.0.0
